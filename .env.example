# Copy to .env and fill in local overrides. Nothing here is required for the default
# local-Parquet pipeline — these only matter if you extend storage to Postgres/Redis
# (see docker-compose.yml).

# Optional: TimescaleDB/PostgreSQL (docker-compose service `db`)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=changeme

# Optional: Redis (docker-compose service `redis`), for dedup-ID cache / hot-path lookups
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
