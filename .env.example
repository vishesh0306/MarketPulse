# Copy to .env and fill in local overrides.

# X session cookies for src.scraper.x_collector (the primary collection path).
# Not an API key and nothing paid — these are the ordinary session cookies of a
# logged-in browser. Get them from a throwaway account:
#   log in at x.com -> DevTools (F12) -> Application -> Cookies -> https://x.com
# Treat them as a password: .env is gitignored, never commit them.
X_AUTH_TOKEN=
X_CT0=
# ...or supply both at once instead: X_COOKIES="auth_token=...; ct0=..."

# Everything below is optional and unused by the default local-Parquet pipeline.

# Optional: TimescaleDB/PostgreSQL (docker-compose service `db`)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=changeme

# Optional: Redis (docker-compose service `redis`), for dedup-ID cache / hot-path lookups
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
