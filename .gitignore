# Virtual environment
.venv/
venv/
env/

# Environment / secrets
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Data (raw/processed/output are regenerated by the pipeline; keep sample_output only)
data/raw/*
data/processed/*
data/output/*
data/output/signals/*
data/output/plots/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/_rejects/
!data/processed/_rejects/.gitkeep
!data/output/.gitkeep
!data/output/signals/
!data/output/signals/.gitkeep
!data/output/plots/
!data/output/plots/.gitkeep

# Logs
logs/*.log
logs/*.json
!logs/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Selenium / browser
*.chromedriver
selenium-debug.log
